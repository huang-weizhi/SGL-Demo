#ifndef __INF_LCD_FONT_H__
#define __INF_LCD_FONT_H__

#include "stdint.h"     /* the tables below may be declared with uint8_t */
/* ASCII font bitmaps used by Inf_lcd.c, one table per size.
 *
 * Table: const unsigned char ascii_<height><width>[][bytes_per_char];
 *   95 chars, index = character code - 0x20 (' ' .. '~'), order matters.
 *   bytes_per_char = ((width + 7) / 8) * height    (each pixel row is
 *   padded to whole bytes, the padding bits are ignored by lcd_show_char).
 *   Storage order (verified against the tables): row-major, top to bottom,
 *   left to right inside a row, low bit first (bit0 = leftmost column),
 *   1 = foreground pixel (negative/阴码).
 *
 * How to generate a new size with PCtoLCD2002: see
 * app/tools/字体取模使用说明.md ; check the result with
 * app/tools/font_preview.py.
 */

