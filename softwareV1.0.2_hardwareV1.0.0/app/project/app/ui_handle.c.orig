        case PAGE_SETTING_SELECT_RESET_CN:
            lcd_show_picture(24, 62, SETTING_PAGE_ICON_RESET_SELECT_CN, spiflash_read);
            lcd_show_picture(78, 259, SETTING_PAGE_ICON_RESET_BACK_UNSELECT_CN, spiflash_read);
            break;

        case PAGE_SETTING_SELECT_RESET_EN:
            // lcd_show_picture(24, 62, SETTING_PAGE_ICON_RESET_SELECT_EN, spiflash_read);
            // lcd_show_picture(78, 259, SETTING_PAGE_ICON_RESET_BACK_UNSELECT_EN, spiflash_read);
            break;

        case PAGE_SETTING_RESET_DONE_CN:
            lcd_show_picture(24, 62, SETTING_PAGE_ICON_RESET_DONE_CN, spiflash_read);
            lcd_show_picture(78, 259, SETTING_PAGE_ICON_RESET_BACK_UNSELECT_CN, spiflash_read);
            break;

        case PAGE_SETTING_RESET_DONE_EN:
            // lcd_show_picture(24, 62, SETTING_PAGE_ICON_RESET_DONE_EN, spiflash_read);
            // lcd_show_picture(78, 259, SETTING_PAGE_ICON_RESET_BACK_UNSELECT_EN, spiflash_read);
            break;

        case PAGE_SETTING_SUPPORT_CN:
            lcd_show_picture(14, 62, SETTING_PAGE_ICON_SUPPORT_CN, spiflash_read);
            break;

        case PAGE_SETTING_SUPPORT_EN:
            // lcd_show_picture(14, 62, SETTING_PAGE_ICON_SUPPORT_EN, spiflash_read);
            break;

        default:
            break;
        }

        this->last_page = this->page;
    }

    if (this->reset_flag == true)
    {
        if (show_reset_time == 400)
        {
            if (last_language == EN)
            {
                this->page = PAGE_SETTING_RESET_DONE_EN;
            }
            else if (last_language == CN)
            {
                this->page = PAGE_SETTING_RESET_DONE_CN;
            }
        }

        show_reset_time--;

        if (show_reset_time <= 0)
        {
            show_reset_time = 400;
            this->reset_flag = false;
            this->page = PAGE_MENU_SELECT_RESET_CN;
        }
    }
}

static void show_other(CZ01_t *this)
{
    static Function_t last_function;
    static bool first_in_cal_page = true;
    static int16_t last_show_cal_temp = 0;
    static int16_t setting_cal_temp_time = 0;

    if (this->page == PAGE_SETTING_SHOW_STYLE_CN ||
            this->page == PAGE_SETTING_SHOW_STYLE_EN)
    {
        if (last_function.show != this->function.show)
        {
            if (this->function.show == SHOW_CURVE)
            {
                lcd_show_picture(177, 142, SETTING_PAGE_ICON_SELECT_OPTION, spiflash_read);
                lcd_show_picture(177, 176, SETTING_PAGE_ICON_UNSELECT_OPTION, spiflash_read);
            }
            else if (this->function.show == SHOW_VALUE)
            {
                lcd_show_picture(177, 142, SETTING_PAGE_ICON_UNSELECT_OPTION, spiflash_read);
                lcd_show_picture(177, 176, SETTING_PAGE_ICON_SELECT_OPTION, spiflash_read);
            }

            last_function.show = this->function.show;
        }
    }
    else if (this->page == PAGE_SETTING_UNIT_CN ||
             this->page == PAGE_SETTING_UNIT_EN)
    {
        if (last_function.unit != this->function.unit)
        {
            if (this->function.unit == FAHRENHEIT)
            {
                lcd_show_picture(177, 142, SETTING_PAGE_ICON_SELECT_OPTION, spiflash_read);
                lcd_show_picture(177, 176, SETTING_PAGE_ICON_UNSELECT_OPTION, spiflash_read);
            }
            else if (this->function.unit == CELSIUS)
            {
                lcd_show_picture(177, 142, SETTING_PAGE_ICON_UNSELECT_OPTION, spiflash_read);
                lcd_show_picture(177, 176, SETTING_PAGE_ICON_SELECT_OPTION, spiflash_read);
            }

            last_function.unit = this->function.unit;
        }
    }
	else if (this->page == PAGE_SETTING_COUNTDOWN_MODE_CN ||
             this->page == PAGE_SETTING_COUNTDOWN_MODE_EN)
			 {
			     if(last_function.countdown != this->function.countdown)
				 {
				                 if (this->function.countdown == BEEP_SOUDS)
            {
                lcd_show_picture(177, 142, SETTING_PAGE_ICON_SELECT_OPTION, spiflash_read);
                lcd_show_picture(177, 176, SETTING_PAGE_ICON_UNSELECT_OPTION, spiflash_read);
            }
            else if (this->function.countdown == BEEP_SOUDS_AND_HEATING_STOP)
            {
                lcd_show_picture(177, 142, SETTING_PAGE_ICON_UNSELECT_OPTION, spiflash_read);
                lcd_show_picture(177, 176, SETTING_PAGE_ICON_SELECT_OPTION, spiflash_read);
            }

            last_function.countdown = this->function.countdown;
				 }
			 }

    if ((this->page == PAGE_SETTING_SPEAKER_CN ||
            this->page == PAGE_SETTING_SPEAKER_EN) ||
            last_function.speaker != this->function.speaker)
    {
        if (last_function.speaker != this->function.speaker)
        {
            if (this->function.speaker == ON)
            {
                lcd_show_picture(215, 8, ICON_VOLUME_ON, spiflash_read);

                if (this->page != PAGE_SETTING_SPEAKER_CN ||
                        this->page != PAGE_SETTING_SPEAKER_CN)
                {
                    goto exit;
                }

                lcd_show_picture(177, 142, SETTING_PAGE_ICON_SELECT_OPTION, spiflash_read);
                lcd_show_picture(177, 176, SETTING_PAGE_ICON_UNSELECT_OPTION, spiflash_read);
            }
            else if (this->function.speaker == OFF)
            {
                lcd_show_picture(215, 8, ICON_VOLUME_OFF, spiflash_read);

                if (this->page != PAGE_SETTING_SPEAKER_CN ||
                        this->page != PAGE_SETTING_SPEAKER_CN)
                {
                    goto exit;
                }

                lcd_show_picture(177, 142, SETTING_PAGE_ICON_UNSELECT_OPTION, spiflash_read);
                lcd_show_picture(177, 176, SETTING_PAGE_ICON_SELECT_OPTION, spiflash_read);
            }
			
exit:
            last_function.speaker = this->function.speaker;
        }
    }
 
	    

    /* show cal temp */
    if (this->page == PAGE_SETTING_CALTEMP_CN ||
            this->page == PAGE_SETTING_CALTEMP_EN)
    {
        if (this->function.unit == CELSIUS)
        {
            if (first_in_cal_page)
            {
                lcd_show_int(148, 136, this->show_set_temp, 3, 1, WHITE, 0x2124, 24);
                this->show_cal_temp_c = this->show_set_temp;
                lcd_show_int(148, 175, this->show_cal_temp_c, 3, 1, WHITE, 0x2124, 24);
                last_show_cal_temp = this->show_cal_temp_c;
                first_in_cal_page = false;
            }

            if (last_show_cal_temp != this->show_cal_temp_c)
            {
                setting_cal_temp_time = 155;
                lcd_show_int(148, 175, this->show_cal_temp_c, 3, 1, GREEN, 0x2124, 24);
                last_show_cal_temp = this->show_cal_temp_c;
            }

            if (setting_cal_temp_time)
            {
                setting_cal_temp_time--;

                if (setting_cal_temp_time < 1)
                {
                    this->cal_temp += this->show_set_temp - this->show_cal_temp_c;

                    if (this->cal_temp > 100)
                    {
                        this->cal_temp = 100;
                    }

                    if (this->cal_temp < -100)
                    {
                        this->cal_temp = -100;
                    }

                    this->show_cal_temp_c = this->show_set_temp;
                    last_show_cal_temp = this->show_set_temp;
                    lcd_show_int(148, 175, this->show_set_temp, 3, 1, WHITE, 0x2124, 24);
                }
            }
        }
        else if (this->function.unit == FAHRENHEIT)
        {
            if (first_in_cal_page)
            {
                lcd_show_int(148, 136, this->show_set_temp, 3, 1, WHITE, 0x2124, 24);
                this->show_cal_temp_f = this->show_set_temp;
                lcd_show_int(148, 175, this->show_cal_temp_f, 3, 1, WHITE, 0x2124, 24);
                last_show_cal_temp = this->show_cal_temp_f;
                first_in_cal_page = false;
            }

            if (last_show_cal_temp != this->show_cal_temp_f)
            {
                setting_cal_temp_time = 155;
                lcd_show_int(148, 175, this->show_cal_temp_f, 3, 1, GREEN, 0x2124, 24);
                last_show_cal_temp = this->show_cal_temp_f;
            }

            if (setting_cal_temp_time)
            {
                setting_cal_temp_time--;

                if (setting_cal_temp_time < 1)
                {
                    this->cal_temp += ((this->show_set_temp - 32) * 5 / 9) - ((this->show_cal_temp_f - 32) * 5 / 9);

                    if (this->cal_temp > 100)
                    {
                        this->cal_temp = 100;
                    }

                    if (this->cal_temp < -100)
                    {
                        this->cal_temp = -100;
                    }

                    this->show_cal_temp_f = this->show_set_temp;
                    last_show_cal_temp = this->show_set_temp;
                    lcd_show_int(148, 175, this->show_set_temp, 3, 1, WHITE, 0x2124, 24);
                }
            }
        }
    }
    else
    {
        first_in_cal_page = true;

        if (setting_cal_temp_time)
        {
            setting_cal_temp_time = 0;

            if (this->function.unit == CELSIUS)
            {
                this->cal_temp += this->show_set_temp - this->show_cal_temp_c;
            }
            else if (this->function.unit == FAHRENHEIT)
            {
                this->cal_temp += ((this->show_set_temp - 32) * 5 / 9) - ((this->show_cal_temp_f - 32) * 5 / 9);
            }

            if (this->cal_temp > 100)
            {
                this->cal_temp = 100;
            }

            if (this->cal_temp < -100)
            {
                this->cal_temp = -100;
            }
        }
    }
}

static void get_data_to_show(CZ01_t *this)
{
    if (this->page == PAGE_CURVE ||
            this->page == PAGE_VALUE)
    {
        return;
    }

    if (this->function.unit == CELSIUS)
    {
        this->show_actual_temp = this->actual_temp_c - this->cal_temp;

        if (scz01.show_actual_temp <= scz01.mcu_temp_c)
        {
            this->show_actual_temp = scz01.mcu_temp_c;
        }

        this->show_set_temp = this->set_temp_c;
    }
    else
    {
        this->show_actual_temp = this->actual_temp_f - (9 * this->cal_temp / 5 + 32);

        if (scz01.show_actual_temp <= scz01.mcu_temp_f)
        {
            scz01.show_actual_temp = scz01.mcu_temp_f;
        }

        this->show_set_temp = this->set_temp_f;
    }
}

void ui_handle(void)
{
    // ui_stats_frame(); /* global monitor: count this UI cycle as one frame */
    show_menu(&scz01);
    show_curve_page(&scz01);
    show_value_page(&scz01);
    show_other(&scz01);
    get_data_to_show(&scz01);
    // ui_stats_update(); /* global monitor: self-throttled FPS/CPU readout */
}
