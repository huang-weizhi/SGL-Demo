          <Key>UL2CM3</Key>
          <Name>UL2CM3(-S0 -C0 -P0 -FD20000000 -FC1000 -FN1 -FF0AT32F415_128 -FS08000000 -FL00020000 -FP0($$Device:-AT32F415CBT7$Flash\AT32F415_128.FLM))</Name>
        </SetRegEntry>
      </TargetDriverDllRegistry>
